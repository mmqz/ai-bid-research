    {
      "cells": [],
      "idx": 44,
      "kind": "ocr_line",
      "locator": "第2页 OCR 行21",
      "text": "3.1.5 投标人须为本项目配备管理团队人员与勘察设计人员 ( 人员数量至少满足"
